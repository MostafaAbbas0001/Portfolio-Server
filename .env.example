# Copy to .env and supply your own credentials. Never commit the filled file.
DATABASE_URL=Host=127.0.0.1;Port=5432;Database=portfolio;Username=portfolio;Password=replace-with-your-database-password
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_PORT=5432
SERVER_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# VPS Docker deployment:
# ASPNETCORE_ENVIRONMENT=Production
# CORS_ORIGINS=https://www.mostafaabbas.dev,https://mostafaabbas.dev
